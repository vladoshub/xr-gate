# SPDX-License-Identifier: MIT

CALIB_TARGET_NAME="leap_motion_uvc_nrf54l15"
CALIB_LABEL="Leap Motion UVC + XIAO nRF54L15 Sense"
CALIB_DEVICE_NAME="leap_motion_uvc_nrf54l15"
# Override per physical assembly, for example CALIB_UNIT_ID=mount_v1_unit_002.
CALIB_UNIT_ID="${CALIB_UNIT_ID:-reference_mount_v1}"
CALIB_PROFILE_NAME="${CALIB_PROFILE_NAME:-stereo_640x480_rot180}"
BASALT_VIO_CONFIG_NAME="${BASALT_VIO_CONFIG_NAME:-basalt_vio_config_640x480.json}"
BASALT_VO_CONFIG_NAME="${BASALT_VO_CONFIG_NAME:-basalt_vo_config_640x480.json}"

EXPECT_WIDTH=640
EXPECT_HEIGHT=480
RECORD_PREFIX="leap_motion_uvc_nrf54l15_640x480_calib"

# Camera-only works before the nRF54L15 board is available.
CAPTURE_CONFIG_CAMERA_ONLY="${CAPTURE_CONFIG_CAMERA_ONLY:-$ROOT_PROJECT/capture_service_cpp/configs/ultraleap_uvc.yaml}"
# Full stereo+IMU target used after the board firmware is available.
CAPTURE_CONFIG_STEREO_IMU="${CAPTURE_CONFIG_STEREO_IMU:-$ROOT_PROJECT/capture_service_cpp/configs/ultraleap_uvc_nrf54l15.yaml}"
CAPTURE_CONFIG="$CAPTURE_CONFIG_STEREO_IMU"

CAMERA_MODEL_0="pinhole-equi"
CAMERA_MODEL_1="pinhole-equi"

IMU_YAML_NAME="imu_nrf54l15_lsm6ds3trc_preliminary.yaml"
IMU_UPDATE_RATE=208.0
# Preliminary values only. Replace with values derived from an Allan-variance
# recording of the final firmware, ODR, full-scale and mounting configuration.
IMU_ACCEL_NOISE_DENSITY=0.01
IMU_ACCEL_RANDOM_WALK=0.001
IMU_GYRO_NOISE_DENSITY=0.001
IMU_GYRO_RANDOM_WALK=0.0001
IMU_PROFILE_NOTE="PRELIMINARY placeholder; measure the final nRF54L15/LSM6DS3TR-C assembly before final camera-IMU calibration"

DEFAULT_RECORD_MODE="camera_only"

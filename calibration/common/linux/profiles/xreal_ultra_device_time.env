# SPDX-License-Identifier: MIT
# Separate output profile prevents reusing the old host-receive time offset.
CALIB_PROFILE_NAME="${CALIB_PROFILE_NAME:-unified_480_ccw90_device_time}"
BASALT_VIO_CONFIG_NAME="${BASALT_VIO_CONFIG_NAME:-basalt_vio_config_${CALIB_PROFILE_NAME}.json}"
BASALT_VO_CONFIG_NAME="${BASALT_VO_CONFIG_NAME:-basalt_vo_config_${CALIB_PROFILE_NAME}.json}"
CAPTURE_CONFIG="${CAPTURE_CONFIG:-$ROOT_PROJECT/devices/xreal_ultra/configs/capture_service/xreal_air2ultra_linux_unified_480_device_time_shm.yaml}"
# shellcheck source=xreal_ultra.env
source "$(dirname "${BASH_SOURCE[0]}")/xreal_ultra.env"
CALIB_TARGET_NAME="xreal_ultra_device_time"
CALIB_LABEL="XREAL Air 2 Ultra (shared device clock, t62)"
RECORD_PREFIX="xreal_device_time_calib"
# The affine lower-envelope fit needs several windows before recording motion.
WARMUP_SECONDS="${WARMUP_SECONDS:-10.0}"

# SPDX-License-Identifier: MIT
# Parallel target profile for the generic calibration tooling.
# The legacy calibration/xreal_ultra/linux flow remains unchanged.

CALIB_TARGET_NAME="xreal_ultra"
CALIB_LABEL="XREAL Air 2 Ultra"
CALIB_DEVICE_NAME="xreal_air2ultra"
CALIB_UNIT_ID="${XREAL_SERIAL:-ZBBM5DZFMP}"
CALIB_PROFILE_NAME="${CALIB_PROFILE_NAME:-unified_480_ccw90}"

EXPECT_WIDTH=480
EXPECT_HEIGHT=640
RECORD_PREFIX="xreal_unified480_calib"

CAPTURE_CONFIG="${CAPTURE_CONFIG:-$ROOT_PROJECT/devices/xreal_ultra/configs/capture_service/xreal_air2ultra_linux_unified_480_shm.yaml}"
CAPTURE_CONFIG_CAMERA_ONLY="$CAPTURE_CONFIG"
CAPTURE_CONFIG_STEREO_IMU="$CAPTURE_CONFIG"

CAMERA_MODEL_0="pinhole-equi"
CAMERA_MODEL_1="pinhole-equi"

IMU_YAML_NAME="imu_xreal_air2ultra.yaml"
IMU_UPDATE_RATE=1000.0
IMU_ACCEL_NOISE_DENSITY=0.01
IMU_ACCEL_RANDOM_WALK=0.001
IMU_GYRO_NOISE_DENSITY=0.001
IMU_GYRO_RANDOM_WALK=0.0001
IMU_PROFILE_NOTE="Existing XREAL baseline values"

DEFAULT_RECORD_MODE="stereo_imu"

+        script = ROOT / "drivers/xrizer/scripts/linux/install_xrizer.sh"
+        result = self.run_session(["bash", str(script)], XR_OFFLINE="1")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        installed = self.root / "bin/drivers/xrizer"

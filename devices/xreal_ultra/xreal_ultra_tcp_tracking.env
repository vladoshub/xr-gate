#!/usr/bin/env bash
# Keep the Ultra calibration and select the TCP sensor receiver.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/xreal_ultra_new_tracking.env" || return

export CAPTURE_SERVICE_CONFIG_PATH="${XR_CAPTURE_INPUT_CONFIG:-$XR_BIN_ROOT/capture_service_cpp/configs/xreal_ultra_tcp_input.yaml}"
export CONFIG_PATH="$CAPTURE_SERVICE_CONFIG_PATH"
export CPP_CAPTURE_CAMERA_TCP_EXIT_ON_DISCONNECT=1

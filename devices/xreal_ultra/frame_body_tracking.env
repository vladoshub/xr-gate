# Require Z > 0 in both virtual-camera joint estimates.
export XR_FRAME_CHECK_POSITIVE_DEPTH="${XR_FRAME_CHECK_POSITIVE_DEPTH:-0}"

# Settings for the physical XREAL Air 2 Ultra stereo cameras.
# Skip neural inference above this pitch; -1 disables the pitch gate.
export XR_FRAME_MAX_CAMERA_PITCH_DEG="${XR_FRAME_MAX_CAMERA_PITCH_DEG:--50}"
export XR_FRAME_PITCH_DOWN_DEG="${XR_FRAME_PITCH_DOWN_DEG:-20}"

# Acceptance checks for each FRAME observation.
export XR_FRAME_CHECK_FIELD_OF_VIEW="${XR_FRAME_CHECK_FIELD_OF_VIEW:-0}"
export XR_FRAME_CHECK_JOINT_DISTANCE="${XR_FRAME_CHECK_JOINT_DISTANCE:-0}"
export XR_FRAME_CHECK_STEREO_DISAGREEMENT="${XR_FRAME_CHECK_STEREO_DISAGREEMENT:-0}"
export XR_FRAME_CHECK_CAMERA_PITCH="${XR_FRAME_CHECK_CAMERA_PITCH:-1}"
export XR_FRAME_MAX_STEREO_DISAGREEMENT_M="${XR_FRAME_MAX_STEREO_DISAGREEMENT_M:-0.24}"

# Allowed distance from either physical camera, in meters.
export XR_FRAME_NECK_MIN_M="${XR_FRAME_NECK_MIN_M:-0.06}"
export XR_FRAME_NECK_MAX_M="${XR_FRAME_NECK_MAX_M:-0.75}"
export XR_FRAME_LEFT_SHOULDER_MIN_M="${XR_FRAME_LEFT_SHOULDER_MIN_M:-0.16}"
export XR_FRAME_LEFT_SHOULDER_MAX_M="${XR_FRAME_LEFT_SHOULDER_MAX_M:-1.05}"
export XR_FRAME_LEFT_ELBOW_MIN_M="${XR_FRAME_LEFT_ELBOW_MIN_M:-0.28}"
export XR_FRAME_LEFT_ELBOW_MAX_M="${XR_FRAME_LEFT_ELBOW_MAX_M:-1.40}"
export XR_FRAME_LEFT_WRIST_MIN_M="${XR_FRAME_LEFT_WRIST_MIN_M:-0.18}"
export XR_FRAME_LEFT_WRIST_MAX_M="${XR_FRAME_LEFT_WRIST_MAX_M:-1.55}"
export XR_FRAME_RIGHT_SHOULDER_MIN_M="${XR_FRAME_RIGHT_SHOULDER_MIN_M:-0.16}"
export XR_FRAME_RIGHT_SHOULDER_MAX_M="${XR_FRAME_RIGHT_SHOULDER_MAX_M:-1.05}"
export XR_FRAME_RIGHT_ELBOW_MIN_M="${XR_FRAME_RIGHT_ELBOW_MIN_M:-0.28}"
export XR_FRAME_RIGHT_ELBOW_MAX_M="${XR_FRAME_RIGHT_ELBOW_MAX_M:-1.40}"
export XR_FRAME_RIGHT_WRIST_MIN_M="${XR_FRAME_RIGHT_WRIST_MIN_M:-0.18}"
export XR_FRAME_RIGHT_WRIST_MAX_M="${XR_FRAME_RIGHT_WRIST_MAX_M:-1.55}"
export XR_FRAME_LEFT_HIP_MIN_M="${XR_FRAME_LEFT_HIP_MIN_M:-0.25}"
export XR_FRAME_LEFT_HIP_MAX_M="${XR_FRAME_LEFT_HIP_MAX_M:-1.80}"
export XR_FRAME_LEFT_KNEE_MIN_M="${XR_FRAME_LEFT_KNEE_MIN_M:-0.30}"
export XR_FRAME_LEFT_KNEE_MAX_M="${XR_FRAME_LEFT_KNEE_MAX_M:-2.20}"
export XR_FRAME_LEFT_FOOT_MIN_M="${XR_FRAME_LEFT_FOOT_MIN_M:-0.35}"
export XR_FRAME_LEFT_FOOT_MAX_M="${XR_FRAME_LEFT_FOOT_MAX_M:-2.60}"
export XR_FRAME_LEFT_TOE_MIN_M="${XR_FRAME_LEFT_TOE_MIN_M:-0.35}"
export XR_FRAME_LEFT_TOE_MAX_M="${XR_FRAME_LEFT_TOE_MAX_M:-2.70}"
export XR_FRAME_RIGHT_HIP_MIN_M="${XR_FRAME_RIGHT_HIP_MIN_M:-0.25}"
export XR_FRAME_RIGHT_HIP_MAX_M="${XR_FRAME_RIGHT_HIP_MAX_M:-1.80}"
export XR_FRAME_RIGHT_KNEE_MIN_M="${XR_FRAME_RIGHT_KNEE_MIN_M:-0.30}"
export XR_FRAME_RIGHT_KNEE_MAX_M="${XR_FRAME_RIGHT_KNEE_MAX_M:-2.20}"
export XR_FRAME_RIGHT_FOOT_MIN_M="${XR_FRAME_RIGHT_FOOT_MIN_M:-0.35}"
export XR_FRAME_RIGHT_FOOT_MAX_M="${XR_FRAME_RIGHT_FOOT_MAX_M:-2.60}"
export XR_FRAME_RIGHT_TOE_MIN_M="${XR_FRAME_RIGHT_TOE_MIN_M:-0.35}"
export XR_FRAME_RIGHT_TOE_MAX_M="${XR_FRAME_RIGHT_TOE_MAX_M:-2.70}"

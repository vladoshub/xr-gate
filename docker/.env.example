# Copy to .env. Values set in the shell take precedence. No shell expressions.
# Release tag. After changing it, stop XR Gate and run sudo ./xr-gate build again.
XR_VERSION=v3.0.0

# Hardware preset; .env and shell values can override individual settings.
XR_HARDWARE_ENV=./hardware/xreal_ultra.env
XR_TCP_PORT=45810
XR_TCP_RATE=60
XR_TCP_MAX_CLIENTS=8
XR_SHM_SIZE=512m
XR_CONFIG_DIR=./config
XR_LOG_DIR=./logs

# Optional separate stereo-video TCP output. Backend still starts via console key 6.
XR_VIDEO_TCP=0
XR_VIDEO_PORT=45700

# Copy to .env. Values set in the shell take precedence. No shell expressions.
# Release tag. After changing it, stop XR Gate and run sudo ./xr-gate build again.
XR_VERSION=v2.8.0

XR_PROFILE=xreal_ultra
XR_TCP_PORT=45810
XR_TCP_RATE=60
XR_TCP_MAX_CLIENTS=8
XR_SHM_SIZE=512m
XR_CONFIG_DIR=./config
XR_LOG_DIR=./logs

# XREAL Air 2 Ultra. Add other USB identities only deliberately, comma-separated.
XR_USB_IDS=3318:0426
# Empty = first capture node (sysfs index 0) belonging to the USB identity above.
# Host camera is mapped to /dev/video0, preserving the release config.
XR_CAMERA_DEVICE=
# Require a local camera; set 0 for remote/TCP or IMU-only profiles.
XR_REQUIRE_CAMERA=1
# HID is optional for generic cameras/serial IMUs. Set 1 for HID-based profiles.
XR_REQUIRE_HIDRAW=0
# USB serial nodes belonging to XR_USB_IDS are discovered automatically.
# Explicit additions, e.g. /dev/ttyACM0 or /dev/serial/by-id/<id> (comma-separated).
XR_SERIAL_DEVICES=

# Gear VR BLE: enable host BlueZ/D-Bus, then configure PROVIDERS in xr_client.json.
XR_BLUETOOTH=0
# For evdev controllers: explicit event nodes, comma-separated. No automatic keyboard access.
XR_INPUT_DEVICES=

# Optional separate stereo-video TCP output. Backend still starts via console key 6.
XR_VIDEO_TCP=0
XR_VIDEO_PORT=45700

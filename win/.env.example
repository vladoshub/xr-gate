# Copy to .env to override saved choices. Use literal values, not shell expressions.
XR_HARDWARE_ENV=hardware/xreal_ultra.env
XR_RELEASE_TAG=latest
XR_DISTRIBUTION=Ubuntu-24.04
XR_LINUX_ROOT=~/xr-gate-wsl
XR_STEAMVR_PATH=
XR_CONTROLLER_CONFIG=
XR_TCP_HOST=127.0.0.1
XR_TCP_PORT=45810
XR_START_TIMEOUT=180

# Optional source-age limit, passed to xr_runtime_adapter (default 500 ms).
# 500 is a temporary WSL timestamp/latency workaround, not a latency correction.
# XR_HMD_MAX_AGE_MS=500

# Optional overrides for the selected hardware preset:
# XR_USB_BUS_IDS=1-2
# XR_BLUETOOTH_BUS_ID=1-4
# XR_DISPLAY_NAME=\\.\DISPLAY2
# XR_DISPLAY_FREQUENCY_HZ=90
# XR_DISPLAY_MODE=extended_sbs
# XR_BLUETOOTH=0
# XR_GEARVR=0

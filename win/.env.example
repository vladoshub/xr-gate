# Copy to .env to override saved choices. Use literal values, not shell expressions.
# Empty until a device is detected or a Hardware preset is chosen manually.
XR_HARDWARE_ENV=
XR_RELEASE_TAG=latest
# Empty URL follows the release tag. Local folder/runtime archive takes priority.
# The Mercury models archive must be beside the runtime (locally or at the URL).
XR_RUNTIME_URL=
XR_RUNTIME_LOCAL_PATH=
XR_DISTRIBUTION=Ubuntu-24.04
XR_LINUX_ROOT=~/xr-gate-wsl
XR_STEAMVR_PATH=
XR_CONTROLLER_CONFIG=
XR_TCP_HOST=127.0.0.1
XR_TCP_PORT=45810
XR_START_TIMEOUT=180
XR_FIRST_LOGIN_TIMEOUT=600
XR_STOP_STEAMVR=1
XR_STEAMVR_STOP_TIMEOUT=10
# The GUI selects gearvr, gestures (controller emulation), simple_gestures (grab / pinch), or no (head tracking only).
XR_CONTROLLER_MODE=gestures
# Optional header artwork. Paths are relative to the bundle's images folder.
XR_CONTROLLER_IMAGE_GESTURES=images/controllers_gestures.png
XR_CONTROLLER_IMAGE_GEARVR=images/controllers_gearvr.png
XR_GLOBAL_HOTKEYS=1
# Keep cursor/windows off the selected XR screen only while tracking is active.
XR_PROTECT_DEVICE_DISPLAY=1
XR_BLUETOOTH=0
# Auto detection reads XR_USB_IDS from hardware/*.env; choosing a preset disables it.
XR_AUTO_DETECT_HARDWARE=1
# Hide only the tracking console, preserving its startup gate/calibration behavior.
XR_SHOW_COMMAND_PROMPT=0
XR_USB_COMMAND_TIMEOUT=30
# Audio is optional. Windows source: default, none, or a saved WASAPI endpoint ID.
XR_AUDIO_ENABLED=1
# WSL output: none, or the persistent ALSA identity selected in the Audio tab.
XR_AUDIO_SOURCE=default
XR_AUDIO_OUTPUT=none
XR_AUTO_DRIVER_FREQUENCY=1
# Installation uses a default SBS package; refresh matching happens at Start VR.
XR_DISPLAY_FREQUENCY_HZ=60
XR_DISPLAY_MODE=extended_sbs
XR_DISPLAY_OPTION=current
XR_BLUETOOTH_READY_TIMEOUT=15
XR_CONTROLLER_INITIAL_SCAN_MS=10000
XR_BLUETOOTH_SCAN_SECONDS=8
XR_WSL_FIRMWARE=1
XR_WSL_FIRMWARE_SOURCE=/lib/firmware
XR_WSL_FIRMWARE_PATH=/mnt/wsl/xr-gate-firmware
# Empty = discover requested Bluetooth firmware filenames from the kernel log.
XR_WSL_FIRMWARE_FILES=
XR_BLUETOOTH_FIRMWARE_PACKAGES=linux-firmware,zstd

# Optional source-age limit, passed to xr_runtime_adapter (default 500 ms).
# 500 is a temporary WSL timestamp/latency workaround, not a latency correction.
# XR_HMD_MAX_AGE_MS=500

# Optional overrides for the selected hardware preset:
# XR_DEVICE_NAME=My XR device
# XR_DEVICE_IMAGE=images/my_device.png
# XR_USB_BUS_IDS=1-2
# XR_BLUETOOTH_BUS_ID=1-4
# XR_BLUETOOTH_USB_ID=0b05:190e
# XR_DISPLAY_NAME=\\.\DISPLAY2
# XR_DISPLAY_FREQUENCY_HZ=90
# XR_DISPLAY_MODE=extended_sbs
# XR_BLUETOOTH=0
# XR_GEARVR=0

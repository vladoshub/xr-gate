<Window x:Class="XrGate.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="Assets/XrGate.ico" Title="XR Gate" Width="1060" Height="800" MinWidth="900" MinHeight="680"
 Background="#0C1320" Foreground="#E5EDF8" FontFamily="Segoe UI" FontSize="14"
 WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Window.Resources>
  <DataTemplate x:Key="BluetoothControllerLabelTemplate">
   <!-- Use the presenter's foreground in both the closed field and popup.
        A local binding overrides the application's light TextBlock style. -->
   <TextBlock Text="{Binding Label}"
    Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource TemplatedParent}, FallbackValue=#162438}" />
  </DataTemplate>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="XR Gate" FontSize="32" FontWeight="SemiBold" />
    <TextBlock x:Name="ProductDescriptionText" Text="6DoF and Hand Tracking Stack" Foreground="#83A3C7" FontSize="11" Margin="2,3,0,0" />
    <TextBlock x:Name="PlatformDescriptionText" Text="Windows launcher" Foreground="#83A3C7" FontSize="12" Margin="2,5,0,0" />
   </StackPanel>
   <Grid x:Name="DeviceHeader" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" MaxWidth="350">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Image x:Name="DeviceArtwork" Grid.Column="0" Width="96" Height="68" Stretch="Uniform" Margin="0,0,10,0" Visibility="Collapsed" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="{Binding DeviceName, StringFormat='Device: {0}'}" ToolTip="{Binding DeviceName}" FontSize="16" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#ACBED5" />
     <TextBlock x:Name="DeviceConnectionStatus" Text="—" HorizontalAlignment="Center" Margin="0,6,0,0" FontWeight="SemiBold">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Foreground" Value="#8994A4" />
       <Style.Triggers>
        <Trigger Property="Text" Value="CONNECTED"><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
        <Trigger Property="Text" Value="TRACKING"><Setter Property="Foreground" Value="#4ADE80" /></Trigger>
        <Trigger Property="Text" Value="NOT CONNECTED"><Setter Property="Foreground" Value="#8994A4" /></Trigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
     </TextBlock>
    </StackPanel>
    <Image x:Name="ControllerArtwork" Grid.Column="2" Width="56" Height="68" Stretch="Uniform" Margin="10,0,0,0" Visibility="Collapsed" />
   </Grid>
   <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="Open Ubuntu" Click="OpenUbuntu_Click" Margin="0,0,8,0" Background="#18253A" />
    <StackPanel Orientation="Horizontal">
     <Button x:Name="ReadmeButton" Content="Readme" Click="Guide_Click" ToolTip="Open the setup and troubleshooting instructions." Margin="0,0,8,0" Background="#18253A" />
     <Button x:Name="GesturesButton" Content="Gestures" Click="Gestures_Click" ToolTip="Open the controller gesture guide." Margin="0" Background="#18253A" />
    </StackPanel>
   </WrapPanel>
  </Grid>
  <Border Grid.Row="1" Background="#18283B" CornerRadius="10" Padding="18" Margin="0,0,0,18">
   <StackPanel>
    <TextBlock x:Name="StatusTitle" Text="Ready to set up" FontWeight="SemiBold" FontSize="17" />
    <TextBlock x:Name="StatusDetail" Text="Connect the glasses and select their display number, then install XR Gate and start VR." Foreground="#ACBED5" TextWrapping="Wrap" Margin="0,6,0,0" />
    <TextBlock x:Name="SetupNoticeText" FontSize="20" FontWeight="Bold" Foreground="#FFD08A" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
    <TextBlock x:Name="WarningText" Foreground="#FFD08A" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed" />
    <Button x:Name="NextStepButton" Content="Continue" Click="NextStep_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <Button x:Name="CancelDiagnosticsButton" Content="Cancel diagnostics" Click="CancelDiagnostics_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <ProgressBar x:Name="Progress" Height="3" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#25364D" />
    <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed" Margin="0,12,0,0">
     <TextBlock x:Name="RecoveryDetail" Foreground="#FFD08A" TextWrapping="Wrap" />
     <WrapPanel Margin="0,10,0,0">
      <Button Content="Open problem file" Click="OpenProblem_Click" Margin="0,0,8,0" />
      <Button Content="Reload settings" Click="ReloadSettings_Click" Margin="0,0,8,0" />
      <Button x:Name="ResetConfigurationButton" Content="Back up &amp; reset this file" Click="ResetConfiguration_Click" Margin="0" />
     </WrapPanel>
    </StackPanel>
   </StackPanel>
  </Border>
  <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
   <TabItem Header="Run">
    <Grid Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <StackPanel x:Name="ActionPanel">
        <Button x:Name="DisplayButton" ToolTipService.ShowOnDisabled="True" Content="Select glasses display" Click="Display_Click" ToolTip="Select the glasses display number so XR Gate can read its refresh rate." />
        <Button x:Name="InstallButton" ToolTipService.ShowOnDisabled="True" Content="Install" Click="Install_Click" ToolTip="Install or update WSL, Ubuntu, XR Gate and the matching SteamVR driver." />
        <Button x:Name="StartButton" ToolTipService.ShowOnDisabled="True" Content="Start VR" Click="Start_Click" ToolTip="F5: attach USB, start XR Gate tracking and open SteamVR when head tracking is ready." Background="{StaticResource Accent}" Foreground="#082A28" FontWeight="SemiBold" FontSize="17" Padding="18,16" />
        <Button x:Name="RestartButton" ToolTipService.ShowOnDisabled="True" Content="Restart tracking" Click="Restart_Click" ToolTip="F7: restart XR Gate inside Ubuntu without restarting SteamVR or detaching USB." />
        <Button x:Name="RefreshStatusButton" ToolTipService.ShowOnDisabled="True" Content="Refresh status" Click="Refresh_Click" ToolTip="Refresh installation, device and tracking status without starting a session." Background="#18253A" />
       </StackPanel>
       <Button x:Name="StopButton" ToolTipService.ShowOnDisabled="True" Content="Stop tracking &amp; return USB" Click="Stop_Click" ToolTip="F6: stop XR Gate, request SteamVR exit and return the selected USB devices to Windows." Background="#4A2932" Margin="0,4,0,15" />
       <Button x:Name="DeleteButton" ToolTipService.ShowOnDisabled="True" Content="Delete" Click="Delete_Click" Background="#4A2932" ToolTip="Delete the saved XR Gate Ubuntu distribution and all its Linux data." Margin="0,0,0,15" />
       <TextBlock Text="STARTUP" Foreground="#79A5C7" FontSize="11" FontWeight="SemiBold" />
       <TextBlock Text="Tracking runs in the background. Enable Show command prompt in Settings before starting to use console calibration and manual controls." Foreground="#A9BBD2" TextWrapping="Wrap" Margin="0,7,6,16" />
       <TextBlock Text="REFRESH RATE" Foreground="#79A5C7" FontSize="11" FontWeight="SemiBold" />
       <TextBlock Text="The driver follows the glasses refresh rate. If a matching variant is unavailable, XR Gate selects 60 Hz and shows a warning." Foreground="#A9BBD2" TextWrapping="Wrap" Margin="0,7,6,12" />
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Column="2" Background="#080E18" CornerRadius="8" Padding="14">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <TextBlock Text="ACTIVITY LOG" Foreground="#79A5C7" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9" />
       <RichTextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="#C9D8EB" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0">
        <FlowDocument PagePadding="0" />
       </RichTextBox>
       <Button x:Name="SaveLogButton" ToolTipService.ShowOnDisabled="True" Grid.Row="2" Content="Save log…" Click="SaveLog_Click" ToolTip="Save the Activity Log to a text file for troubleshooting." HorizontalAlignment="Right" Background="#1A293E" Margin="0,12,0,0" Padding="12,7" />
      </Grid>
     </Border>
    </Grid>
   </TabItem>
   <TabItem x:Name="ControllersTab" Header="Controllers">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
     <StackPanel x:Name="ControllersPanel" MaxWidth="760" HorizontalAlignment="Left" SourceUpdated="ControllerSetting_SourceUpdated">
      <TextBlock Text="Controllers" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
      <TextBlock Text="Controller input" />
      <ComboBox x:Name="ControllerModeBox" SelectedValuePath="Id" SelectedValue="{Binding ControllerMode, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" ItemTemplate="{StaticResource BluetoothControllerLabelTemplate}" IsSynchronizedWithCurrentItem="False" Foreground="#162438" Background="#F2F5F8" Margin="0,6,0,12" />
      <TextBlock Text="Gestures uses optical hands (default). Gear VR Controllers uses physical controllers. No enables head tracking without controllers. Stop tracking before changing modes or pairing." Foreground="#ACBED5" TextWrapping="Wrap" Margin="0,0,0,12" />
      <CheckBox x:Name="BluetoothEnabledBox" Content="Enable Bluetooth" IsChecked="{Binding BluetoothEnabled, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
      <TextBlock Text="Bluetooth USB BUSID (optional; overrides VID:PID)" /><TextBox x:Name="BluetoothBusIdBox" Text="{Binding BluetoothBusId, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
      <TextBlock Text="Bluetooth VID:PID (used when BUSID is empty)" /><TextBox x:Name="BluetoothUsbIdBox" Text="{Binding BluetoothUsbId, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
      <TextBlock Text="For automatic Bluetooth selection, clear BUSID and set VID:PID. Clear both to keep the saved adapter. Camera / IMU BUSIDs keep their saved selection when empty." Foreground="#8FA6C3" TextWrapping="Wrap" />

      <TextBlock Text="Put the controllers into pairing mode, then select them by name." Foreground="#ACBED5" TextWrapping="Wrap" Margin="0,10,0,10" />
      <Button Content="Pair Bluetooth controllers" Click="Pair_Click" HorizontalAlignment="Left" />
      <Border x:Name="BluetoothControllersPanel" Visibility="Collapsed" Background="#18283B" CornerRadius="8" Padding="14" Margin="0,8,0,12">
       <StackPanel>
        <TextBlock Text="Bluetooth controllers" FontWeight="SemiBold" />
        <TextBlock Text="Select by name; MAC addresses distinguish controllers with identical names. Not selected disables that side in the saved controller config." TextWrapping="Wrap" Foreground="#ACBED5" Margin="0,8,0,12" />
        <TextBlock Text="Left controller" />
        <ComboBox x:Name="LeftBluetoothController" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" ItemTemplate="{StaticResource BluetoothControllerLabelTemplate}" SelectedValuePath="Address" IsSynchronizedWithCurrentItem="False" Foreground="#162438" Background="#F2F5F8" Margin="0,6,0,12" />
        <TextBlock Text="Right controller" />
        <ComboBox x:Name="RightBluetoothController" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" ItemTemplate="{StaticResource BluetoothControllerLabelTemplate}" SelectedValuePath="Address" IsSynchronizedWithCurrentItem="False" Foreground="#162438" Background="#F2F5F8" Margin="0,6,0,12" />
        <WrapPanel>
         <Button Content="Connect &amp; save" Click="SaveBluetoothControllers_Click" Margin="0,0,8,0" />
         <Button Content="Scan again" Click="Pair_Click" Margin="0" />
        </WrapPanel>
       </StackPanel>
      </Border>
      <TextBlock Text="Import controller JSON (optional)" /><TextBox x:Name="ControllerConfigBox" Text="{Binding ControllerConfig, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" />
      <TextBlock x:Name="ControllerSaveStatus" Text="Changes are saved automatically." Foreground="#ACBED5" TextWrapping="Wrap" />
      <WrapPanel Margin="0,12,0,0">
       <Button Content="Register / train controllers" Click="Controllers_Click" Margin="0,0,10,10" />
      </WrapPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="AudioTab" Header="Audio">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
      <Border x:Name="AudioFields" Background="#18283B" CornerRadius="8" Padding="16" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="Audio" FontSize="18" FontWeight="SemiBold" />
        <CheckBox x:Name="AudioEnabledBox" Content="Enable" IsChecked="{Binding AudioEnabled, UpdateSourceTrigger=PropertyChanged}" Click="AudioEnabled_Click" Margin="0,10,0,6" />
        <TextBlock Text="Send sound from a Windows output to an audio device attached to Ubuntu. Start VR keeps an available saved output or selects the first available Ubuntu output. Disable Enable to keep audio off. Choices are saved automatically." Foreground="#ACBED5" TextWrapping="Wrap" Margin="0,6,0,14" />
        <StackPanel x:Name="AudioDeviceFields" IsEnabled="{Binding IsChecked, ElementName=AudioEnabledBox}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Windows audio source" />
          <ComboBox x:Name="WindowsAudioSource" SelectedValuePath="Id" ItemTemplate="{StaticResource BluetoothControllerLabelTemplate}" SelectionChanged="AudioSelection_Changed" IsSynchronizedWithCurrentItem="False" Foreground="#162438" Background="#F2F5F8" Margin="0,6,0,12" ToolTip="{Binding SelectedItem.Id, RelativeSource={RelativeSource Self}}" />
         </StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Audio output in Ubuntu" />
          <ComboBox x:Name="WslAudioOutput" SelectedValuePath="Id" ItemTemplate="{StaticResource BluetoothControllerLabelTemplate}" SelectionChanged="AudioSelection_Changed" IsSynchronizedWithCurrentItem="False" Foreground="#162438" Background="#F2F5F8" Margin="0,6,0,12" ToolTip="{Binding SelectedItem.Id, RelativeSource={RelativeSource Self}}" />
         </StackPanel>
        </Grid>
        <Button x:Name="RefreshAudioDevicesButton" Content="Refresh audio devices" Click="RefreshAudioDevices_Click" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock x:Name="AudioStatus" Text="Audio output is selected automatically at Start VR when available. The source Windows output may also play the sound locally." Foreground="#ACBED5" TextWrapping="Wrap" />
       </StackPanel>
      </Border>
    </ScrollViewer>
   </TabItem>
   <TabItem x:Name="SettingsTab" Header="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
     <StackPanel x:Name="SettingsPanel">
      <Grid x:Name="SettingsFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Hardware preset" />
        <DockPanel><Button Content="Browse…" Click="BrowseHardware_Click" DockPanel.Dock="Right" Margin="8,5,0,13" Padding="10,7" />
         <ComboBox x:Name="HardwarePresetBox" SelectedValuePath="Path" ItemTemplate="{StaticResource BluetoothControllerLabelTemplate}" SelectionChanged="HardwarePreset_Changed" IsSynchronizedWithCurrentItem="False" Foreground="#162438" Background="#F2F5F8" Margin="0,5,0,13" ToolTip="{Binding SelectedItem.Path, RelativeSource={RelativeSource Self}}" />
        </DockPanel>
        <CheckBox x:Name="AutoDetectHardwareBox" Content="Detect hardware automatically" IsChecked="{Binding AutoDetectHardware}" Click="AutoDetectHardware_Click" />
        <TextBlock x:Name="HardwareDetectionStatus" Text="Presets are loaded from hardware/*.env. You can always choose another preset." Foreground="#8FA6C3" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="Ubuntu distribution" /><TextBox Text="{Binding Distribution, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox x:Name="ShowCommandPromptBox" Content="Show command prompt" IsChecked="{Binding ShowCommandPrompt}" />
        <TextBlock Text="Off by default. Enable before Start VR to show the tracking console for calibration commands and startup prompts." Foreground="#8FA6C3" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Text="Release tag" /><TextBox Text="{Binding ReleaseTag, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Camera / IMU USB BUSIDs (optional, comma-separated)" /><TextBox Text="{Binding UsbBusIds, UpdateSourceTrigger=PropertyChanged}" />

       </StackPanel>
       <StackPanel Grid.Column="2">
        <CheckBox Content="Match driver to glasses refresh rate automatically" IsChecked="{Binding AutoDriverFrequency}" Margin="0,0,0,15" />
        <TextBlock Text="Manual refresh rate, Hz (automatic selection overrides this)" TextWrapping="Wrap" /><TextBox Text="{Binding FrequencyHz, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Display mode: extended_sbs or direct" /><TextBox Text="{Binding DisplayMode, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Glasses output name (optional, e.g. \\.\DISPLAY2)" /><TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="SteamVR folder (optional; otherwise detected)" /><TextBox Text="{Binding SteamVrPath, UpdateSourceTrigger=PropertyChanged}" />
       </StackPanel>
      </Grid>

      <Border Background="#18283B" CornerRadius="8" Padding="16" Margin="0,16,0,0" IsEnabled="{Binding IsEnabled, ElementName=SettingsFields}">
       <StackPanel>
        <TextBlock Text="XR Gate installation source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="URL XR Gate" />
        <TextBox x:Name="RuntimeUrlBox" Text="{Binding RuntimeDownloadUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RuntimeUrlEnabled}" ToolTip="The runtime archive URL. Empty uses the selected release tag; models are downloaded beside the runtime." />
        <TextBlock Text="Local path XR Gate" />
        <DockPanel>
         <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Folder…" Click="BrowseRuntimeFolder_Click" Margin="8,5,0,13" Padding="10,7" />
          <Button Content="Archive…" Click="BrowseRuntimeArchive_Click" Margin="8,5,0,13" Padding="10,7" />
         </StackPanel>
         <TextBox x:Name="RuntimeLocalPathBox" Text="{Binding RuntimeLocalPath, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <TextBlock Text="A local path takes priority over the URL. Select the runtime .tar.gz or a folder containing xr-gate-ubuntu-24.04-linux-x64.tar.gz and hand-tracking-models-mercury.tar.gz. For a custom URL, keep the models archive beside the runtime." Foreground="#ACBED5" TextWrapping="Wrap" />
       </StackPanel>
      </Border>

      <Border Background="#18283B" CornerRadius="8" Padding="16" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="Hotkeys" FontSize="18" FontWeight="SemiBold" />
        <CheckBox x:Name="GlobalHotkeysBox" Content="Enable global hotkeys" IsChecked="{Binding GlobalHotkeys, UpdateSourceTrigger=PropertyChanged}" Click="GlobalHotkeys_Click" Margin="0,10,0,8" />
        <TextBlock Text="F5 — Start VR" />
        <TextBlock Text="F6 — Stop tracking &amp; return USB" Margin="0,4,0,0" />
        <TextBlock Text="F7 — Restart tracking (keep SteamVR running)" Margin="0,4,0,0" />
        <TextBlock x:Name="HotkeysStatus" Text="Work while XR Gate is open, including when minimized. The same startup and cleanup checks apply as for the buttons." Foreground="#ACBED5" TextWrapping="Wrap" Margin="0,8,0,0" />
       </StackPanel>
      </Border>
      <WrapPanel Margin="0,16,0,0">
       <Button x:Name="SaveSettingsButton" Content="Save settings" Click="SaveSettings_Click" Background="{StaticResource Accent}" Foreground="#082A28" Margin="0,0,10,10" />
       <Button Content="List USB devices" Click="ListUsb_Click" Margin="0,0,10,10" />
       <Button x:Name="AdvancedSettingsButton" Content="Open advanced settings" Click="Advanced_Click" Margin="0,0,10,10" />
      </WrapPanel>
      <Border x:Name="UsbDevicesPanel" Visibility="Collapsed" Background="#080E18" CornerRadius="8" Padding="14" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="USB DEVICES" Foreground="#79A5C7" FontSize="11" FontWeight="SemiBold" />
        <TextBlock x:Name="UsbDevicesStatus" Foreground="#ACBED5" TextWrapping="Wrap" Margin="0,8,0,10" />
        <TextBox x:Name="UsbDevicesOutput" AutomationProperties.Name="USB device list" IsReadOnly="True" Height="180" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="12" Foreground="#C9D8EB" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0" Margin="0" />
       </StackPanel>
      </Border>
      <TextBlock Text="Changing the release, display mode or manual refresh rate requires Install again. Automatic refresh-rate selection also runs before starting VR." Foreground="#8FA6C3" TextWrapping="Wrap" Margin="0,0,0,12" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Tools">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
     <StackPanel x:Name="ToolsPanel" MaxWidth="650" HorizontalAlignment="Left">
      <TextBlock Text="Connect and configure" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
      <Button Content="Diagnostics" Click="Doctor_Click" />
      <Button Content="Register SteamVR driver" Click="Driver_Click" />
      <Button Content="Start tracking without SteamVR" Click="Tracking_Click" />
      <Button Content="Check live head tracking" Click="Test_Click" />
      <TextBlock Text="Close SteamVR before selecting a different display or driver variant. Enable SBS and Extend these displays in Windows for extended_sbs output." Foreground="#A9BBD2" TextWrapping="Wrap" Margin="0,12,0,0" />
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <DockPanel Grid.Row="3" Margin="0,18,0,0">
   <TextBlock DockPanel.Dock="Right" FontSize="11" Margin="16,0,0,0"><Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/vladoshub/xr-gate" RequestNavigate="Project_RequestNavigate" Foreground="#83CFC5">github.com/vladoshub/xr-gate</Hyperlink></TextBlock>
   <TextBlock Text="Windows x64  ·  .NET included  ·  WSL stays active while this launcher is open" Foreground="#6F87A5" FontSize="11" />
  </DockPanel>
 </Grid>
</Window>

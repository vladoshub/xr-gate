# Copy to generic.env and fill the settings required by your hardware/profile.
XR_TARGET_DEVICE=generic
XR_DEVICE_NAME=XR device
XR_PROFILE=
XR_USB_IDS=
XR_USB_BUS_IDS=
XR_USB_INSTANCE_IDS=
# Empty flags keep saved choices; use 0 to disable or 1 to enable.
XR_BLUETOOTH=
XR_GEARVR=
XR_BLUETOOTH_BUS_ID=
# Optional single VID:PID for automatic selection when BUSID is empty.
XR_BLUETOOTH_USB_ID=
XR_BLUETOOTH_INSTANCE_ID=
# Explicit primary camera path, or opt into unique-node discovery using XR_USB_IDS.
XR_CAMERA_AUTO_SELECT=0
XR_CAMERA_DEVICE=
XR_HIDRAW_DEVICES=
XR_SERIAL_DEVICES=
XR_INPUT_DEVICES=
XR_REQUIRE_CAMERA=0
XR_REQUIRE_HIDRAW=0
XR_KERNEL_MODULES=
XR_DEVICE_ACCESS_SCRIPT=

XR_DISPLAY_FREQUENCY_HZ=
XR_DISPLAY_MODE=extended_sbs
XR_DISPLAY_OPTION=current
XR_DISPLAY_NAME=
XR_DISPLAY_MATCH=
XR_WINDOW_WIDTH=
XR_WINDOW_HEIGHT=
XR_RENDER_WIDTH=
XR_RENDER_HEIGHT=

XR_CONTROLLER_PROVIDERS=evdev
XR_GEARVR_TEMPLATE=empty_gearvr.json
XR_CONTROLLER_PROFILE_LABEL=Configured BLE / IMU controller profile
XR_GEARVR_PROVIDERS=evdev,gearvr_ble
XR_GEARVR_CONNECT_PROVIDERS=gearvr_ble

XR_IPD_METERS=
XR_PROJECTION_LEFT=
XR_PROJECTION_RIGHT=
XR_PROJECTION_TOP=
XR_PROJECTION_BOTTOM=

# SteamVR identities; keep these when updating an existing device.
XR_HMD_SERIAL=xr-tracking-hmd-001
XR_LEFT_HAND_SERIAL=xr-tracking-left-hand-001
XR_RIGHT_HAND_SERIAL=xr-tracking-right-hand-001

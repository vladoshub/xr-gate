# Copy this preset and select the copy with XR_HARDWARE_ENV in .env.
XR_TARGET_DEVICE=xreal_ultra
XR_DEVICE_NAME=XREAL ULTRA
XR_DEVICE_IMAGE=images/xreal_ultra.png
XR_PROFILE=xreal_ultra
XR_USB_IDS=3318:0426
XR_USB_BUS_IDS=
XR_USB_INSTANCE_IDS=
# Empty flags keep saved choices; use 0 to disable or 1 to enable.
XR_BLUETOOTH=
XR_GEARVR=
XR_BLUETOOTH_BUS_ID=
# Default dedicated Bluetooth adapter; BUSID / explicit instance overrides this.
XR_BLUETOOTH_USB_ID=0b05:190e
XR_BLUETOOTH_INSTANCE_ID=
XR_CAMERA_DEVICE=
# Resolve the capture node by XR_USB_IDS; /dev/videoN changes after USB reattach.
XR_CAMERA_AUTO_SELECT=1
XR_HIDRAW_DEVICES=
XR_SERIAL_DEVICES=
XR_INPUT_DEVICES=
XR_REQUIRE_CAMERA=1
XR_REQUIRE_HIDRAW=1
XR_KERNEL_MODULES=uvcvideo,hid_generic,btusb
XR_DEVICE_ACCESS_SCRIPT=devices/xreal_ultra/linux/scripts/install_xreal_ultra_device_access.sh

XR_DISPLAY_FREQUENCY_HZ=60
XR_DISPLAY_MODE=extended_sbs
XR_DISPLAY_OPTION=current
XR_DISPLAY_NAME=
# Both EDID model code and friendly name must match this device.
XR_DISPLAY_MODEL_ID=MRG3136
XR_DISPLAY_MODEL_NAME=Air 2 Ultra
XR_DISPLAY_MATCH=
# Optional: omit for devices with a single display mode.
SBS_RESOLUTION=3840x1080
XR_WINDOW_WIDTH=3840
XR_WINDOW_HEIGHT=1080
XR_RENDER_WIDTH=1920
XR_RENDER_HEIGHT=1080

XR_CONTROLLER_PROVIDERS=evdev
XR_GEARVR_TEMPLATE=empty_gearvr.json
XR_CONTROLLER_PROFILE_LABEL=Gear VR controllers
XR_GEARVR_PROVIDERS=evdev,gearvr_ble
XR_GEARVR_CONNECT_PROVIDERS=gearvr_ble

XR_IPD_METERS=0.064
XR_PROJECTION_LEFT=-1.0
XR_PROJECTION_RIGHT=1.0
XR_PROJECTION_TOP=-1.0
XR_PROJECTION_BOTTOM=1.0

# SteamVR identities; keep these when updating an existing device.
XR_HMD_SERIAL=xreal-ultra-hmd-001
XR_LEFT_HAND_SERIAL=xreal-ultra-left-hand-001
XR_RIGHT_HAND_SERIAL=xreal-ultra-right-hand-001

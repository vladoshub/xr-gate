# Leap Motion UVC camera-only spatial profile.
# Runtime IMU and pose are intentionally disabled; output remains in camera coordinates.
SPATIAL_MAPPER_PROFILE_NAME="${SPATIAL_MAPPER_PROFILE_NAME:-leap_motion_uvc}"
CALIB_PROFILE_NAME="${CALIB_PROFILE_NAME:-stereo_640x480_rot180}"
CALIB_JSON="${CALIB_JSON:-$ROOT_PROJECT/calibration_dataset/final/leap_motion_uvc/reference_unit/stereo_640x480_rot180/stereo_calib_640x480.json}"
SPATIAL_POSE_INPUT="${SPATIAL_POSE_INPUT:-none}"
SPATIAL_MAP_FRAME="${SPATIAL_MAP_FRAME:-camera}"
CAPTURE_IMU_REQUIRED="${CAPTURE_IMU_REQUIRED:-0}"
DEPTH_FRAME_ID="${DEPTH_FRAME_ID:-cam0_rect}"
MAP_FRAME_ID="${MAP_FRAME_ID:-$DEPTH_FRAME_ID}"
QUALITY_MAX_POSE_DELTA_M="${QUALITY_MAX_POSE_DELTA_M:-0}"
QUALITY_MAX_POSE_DELTA_DEG="${QUALITY_MAX_POSE_DELTA_DEG:-0}"
QUALITY_WRITE_POSE_HEALTH_CSV="${QUALITY_WRITE_POSE_HEALTH_CSV:-0}"

# Fill remaining device-neutral defaults.
# shellcheck source=reference.env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reference.env"

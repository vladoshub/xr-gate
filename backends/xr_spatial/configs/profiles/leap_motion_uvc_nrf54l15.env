# Leap Motion UVC + nRF54L15 reference-mount spatial profile.
SPATIAL_MAPPER_PROFILE_NAME="${SPATIAL_MAPPER_PROFILE_NAME:-leap_motion_uvc_nrf54l15}"
CALIB_PROFILE_NAME="${CALIB_PROFILE_NAME:-stereo_640x480_rot180}"
CALIB_JSON="${CALIB_JSON:-$ROOT_PROJECT/calibration_dataset/final/leap_motion_uvc_nrf54l15/reference_mount_v1/stereo_640x480_rot180/basalt_calib_stereo_640x480_rot180.json}"
SPATIAL_POSE_INPUT="${SPATIAL_POSE_INPUT:-shm}"
SPATIAL_MAP_FRAME="${SPATIAL_MAP_FRAME:-tracking}"
CAPTURE_IMU_REQUIRED="${CAPTURE_IMU_REQUIRED:-0}"

# Fill remaining device-neutral defaults.
# shellcheck source=reference.env
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/reference.env"

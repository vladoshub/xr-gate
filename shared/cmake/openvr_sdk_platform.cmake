# Match the SDK's directory layout for the CMake target architecture.
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _xr_openvr_processor)
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(_xr_openvr_bits 64)
else()
  set(_xr_openvr_bits 32)
endif()

if(WIN32)
  set(OPENVR_ARCH_TARGET "win${_xr_openvr_bits}")
elseif(APPLE)
  set(OPENVR_ARCH_TARGET "osx${_xr_openvr_bits}")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND _xr_openvr_processor MATCHES "^(aarch64|arm64)$")
  set(OPENVR_ARCH_TARGET linuxarm64)
else()
  set(OPENVR_ARCH_TARGET "linux${_xr_openvr_bits}")
endif()

set(OPENVR_SDK_LIBRARY_SUFFIXES "${OPENVR_ARCH_TARGET}")
if(NOT OPENVR_ARCH_TARGET STREQUAL "linuxarm64")
  list(APPEND OPENVR_SDK_LIBRARY_SUFFIXES linux64 win64 osx32)
endif()
unset(_xr_openvr_bits)
unset(_xr_openvr_processor)

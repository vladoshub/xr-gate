#!/usr/bin/env bash
# Generic side-by-side profile. Override these values or create profiles/<device>.env.
export XR_MONADO_EYE_WIDTH="${XR_MONADO_EYE_WIDTH:-1920}"
export XR_MONADO_EYE_HEIGHT="${XR_MONADO_EYE_HEIGHT:-1080}"
export XR_MONADO_WINDOW_WIDTH="${XR_MONADO_WINDOW_WIDTH:-3840}"
export XR_MONADO_WINDOW_HEIGHT="${XR_MONADO_WINDOW_HEIGHT:-1080}"
export XR_MONADO_DISPLAY_WIDTH_M="${XR_MONADO_DISPLAY_WIDTH_M:-0.120}"
export XR_MONADO_DISPLAY_HEIGHT_M="${XR_MONADO_DISPLAY_HEIGHT_M:-0.034}"
export XR_MONADO_IPD_M="${XR_MONADO_IPD_M:-0.064}"
export XR_MONADO_LENS_VERTICAL_POSITION_M="${XR_MONADO_LENS_VERTICAL_POSITION_M:-0.017}"
export XR_MONADO_FOV_HORIZONTAL_DEG="${XR_MONADO_FOV_HORIZONTAL_DEG:-90}"
export XR_MONADO_FOV_VERTICAL_DEG="${XR_MONADO_FOV_VERTICAL_DEG:-90}"
export XR_MONADO_REFRESH_HZ="${XR_MONADO_REFRESH_HZ:-90}"

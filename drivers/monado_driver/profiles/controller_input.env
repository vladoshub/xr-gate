#!/usr/bin/env bash
# Virtual input policy shared by all hardware profiles. Explicit env wins.
export XR_MONADO_CONTROLLER_LEFT_AB_XY_ALIAS="${XR_MONADO_CONTROLLER_LEFT_AB_XY_ALIAS:-1}"
export XR_MONADO_CONTROLLER_TRACKPAD_CLICK_FROM_TOUCH="${XR_MONADO_CONTROLLER_TRACKPAD_CLICK_FROM_TOUCH:-0}"
export XR_MONADO_CONTROLLER_AXIS_THRESHOLD="${XR_MONADO_CONTROLLER_AXIS_THRESHOLD:-0.05}"
export XR_MONADO_CONTROLLER_CLICK_THRESHOLD="${XR_MONADO_CONTROLLER_CLICK_THRESHOLD:-0.55}"
export XR_MONADO_CONTROLLER_EXPOSE_SYSTEM_BUTTON="${XR_MONADO_CONTROLLER_EXPOSE_SYSTEM_BUTTON:-1}"
# Native Touch has priority; this list orders the alternative profiles.
export XR_MONADO_CONTROLLER_PROFILE_ORDER="${XR_MONADO_CONTROLLER_PROFILE_ORDER:-index,wmr,vive,simple}"

# Source the same file in the Monado service AND in the OpenXR application's
# environment (openxr_runtime_env.sh loads it). Explicit environment wins.
export XR_MONADO_TRANSPORT="${XR_MONADO_TRANSPORT:-shm}"
export XR_MONADO_TCP_HOST="${XR_MONADO_TCP_HOST:-127.0.0.1}"
export XR_MONADO_TCP_PORT="${XR_MONADO_TCP_PORT:-45810}"
export XR_MONADO_TCP_RECONNECT_MS="${XR_MONADO_TCP_RECONNECT_MS:-500}"
export XR_MONADO_TCP_TIMEOUT_MS="${XR_MONADO_TCP_TIMEOUT_MS:-1000}"
export XR_MONADO_RECENTER_ON_REACQUIRE="${XR_MONADO_RECENTER_ON_REACQUIRE:-1}"
export XR_MONADO_SPATIAL="${XR_MONADO_SPATIAL:-0}"
export XR_MONADO_VIDEO="${XR_MONADO_VIDEO:-0}"
# Spatial defaults to the same transport as tracking. Video is independent:
# SHM from the runtime by default; TCP may read xr_video's binary TCP server.
export XR_MONADO_SPATIAL_TRANSPORT="${XR_MONADO_SPATIAL_TRANSPORT:-$XR_MONADO_TRANSPORT}"
export XR_MONADO_SPATIAL_MAX_AGE_MS="${XR_MONADO_SPATIAL_MAX_AGE_MS:-1500}"
export XR_MONADO_VIDEO_TRANSPORT="${XR_MONADO_VIDEO_TRANSPORT:-shm}"
export XR_MONADO_VIDEO_MAX_AGE_MS="${XR_MONADO_VIDEO_MAX_AGE_MS:-250}"
export XR_MONADO_VIDEO_TCP_HOST="${XR_MONADO_VIDEO_TCP_HOST:-127.0.0.1}"
export XR_MONADO_VIDEO_TCP_PORT="${XR_MONADO_VIDEO_TCP_PORT:-45812}"

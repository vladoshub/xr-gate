@@ -140,6 +140,14 @@ oxr_xrWaitFrame(XrSession session, const XrFrameWaitInfo *frameWaitInfo, XrFrame
 	OXR_VERIFY_ARG_TYPE_AND_NOT_NULL(&log, frameState, XR_TYPE_FRAME_STATE);
 	OXR_VERIFY_ARG_NOT_NULL(&log, frameState);
 
+	// Use the incoming runtime pose's invalid -> valid edge, not a jump in
+	// position/reset_counter and not the driver's finite identity fallback.
+	// Recenter via the overseer so controllers, hands, spatial geometry and
+	// reference-space-change events use the same transformation.
+	if (xr_gate_reacquired(session)) {
+		xrt_space_overseer_recenter_local_spaces(sess->sys->xso);
+	}
+
 	return oxr_session_frame_wait(&log, sess, frameState);
 }
 

@@ -204,3 +204,33 @@ target_include_directories(
 	PRIVATE ${CMAKE_CURRENT_BINARY_DIR}
 	INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/..
 	)
+
+# Project-owned XR Gate optional spatial/video OpenXR interface.
+if(NOT XR_TRACKING_ROOT)
+  message(FATAL_ERROR "XR_TRACKING_ROOT is required for XR Gate OpenXR data support")
+endif()
+set(_xr_gate_driver "${XR_TRACKING_ROOT}/drivers/monado_driver")
+target_sources(st_oxr PRIVATE
+  ${_xr_gate_driver}/openxr/monado_bridge.c
+  ${_xr_gate_driver}/openxr/spatial_api.cpp
+  ${_xr_gate_driver}/openxr/sensor_source.cpp
+  ${_xr_gate_driver}/src/runtime_readers.cpp
+  ${_xr_gate_driver}/src/posix_runtime_readers.cpp
+  ${_xr_gate_driver}/src/windows_runtime_readers.cpp
+  ${XR_TRACKING_ROOT}/drivers/openvr_driver/src/runtime_tcp_client.cpp
+  ${XR_TRACKING_ROOT}/drivers/openvr_driver/src/runtime_tcp_readers.cpp)
+target_include_directories(st_oxr PRIVATE
+  ${_xr_gate_driver}/include
+  ${_xr_gate_driver}/openxr
+  ${XR_TRACKING_ROOT}/drivers/openvr_driver/src
+  ${XR_TRACKING_ROOT}/shared/include)
+target_include_directories(xrt-interfaces INTERFACE ${_xr_gate_driver}/openxr)
+target_compile_features(st_oxr PRIVATE cxx_std_17)
+target_compile_definitions(st_oxr PRIVATE XR_GATE_USE_SHARED_HAND_CONTRACT=1)
+find_package(Threads REQUIRED)
+target_link_libraries(st_oxr PRIVATE Threads::Threads)
+if(WIN32)
+  target_link_libraries(st_oxr PRIVATE ws2_32)
+elseif(UNIX AND NOT APPLE)
+  target_link_libraries(st_oxr PRIVATE rt)
+endif()

index 0000000..8ec3e1e
--- /dev/null
+++ b/win/package_windows.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""Assemble or validate the Windows installer and selected SteamVR variants."""
+import argparse
+import hashlib
+import json
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import tempfile
+from zipfile import ZipFile, ZIP_DEFLATED
+
+ROOT_NAME = "xr-gate-windows"
+REQUIRED = ("INSTALL.cmd", "RUN.cmd", "DISPLAY.cmd", "USB.cmd", "XrGate-Wsl.ps1",
+            ".env.example", "windows/Environment.ps1",
+            "windows/Display.ps1", "windows/DisplayNative.cs", "linux/xr_gate_wsl.py",
+            "README.md", "README.ru.md", "START-HERE.html", "START-HERE.ru.html")
+
+
+def selections(frequencies, modes):
+    frequencies = list(dict.fromkeys(filter(None, re.split(r"[\s,;]+", frequencies))))
+    modes = list(dict.fromkeys(filter(None, re.split(r"[\s,;]+", modes))))
+    if not frequencies or not modes:
+        raise ValueError("Select at least one frequency and display mode.")
+    if any(not re.fullmatch(r"[1-9][0-9]{0,3}", value) or int(value) > 1000 for value in frequencies):
+        raise ValueError("Frequencies must be integer Hz values from 1 to 1000.")
+    if any(value not in ("direct", "extended_sbs") for value in modes):
+        raise ValueError("Modes must be direct or extended_sbs.")
+    return [(int(hz), mode) for hz in frequencies for mode in modes]
+
+
+def variant_path(hz, mode):
+    return f"drivers/{hz}Hz-{mode}/xr_tracking"
+
+
+def hardware_preset(env):
+    match = re.search(r"(?m)^XR_HARDWARE_ENV=(.+)$", env)
+    relative = PurePosixPath(match.group(1).strip().strip("\"'")) if match else None
+    if not relative or relative.is_absolute() or ".." in relative.parts or "\\" in str(relative):
+        raise ValueError("XR_HARDWARE_ENV must select a preset inside the Windows bundle.")
+    return relative.as_posix()
+
+
+def verify(path, frequencies, modes):
+    expected = selections(frequencies, modes)
+    with ZipFile(path) as package:
+        names = package.namelist()
+        if len(names) != len(set(names)):
+            raise ValueError("Duplicate ZIP entries.")
+        for name in names:
+            parts = PurePosixPath(name).parts
+            if not parts or parts[0] != ROOT_NAME or ".." in parts or "\\" in name:
+                raise ValueError("Unexpected ZIP entry: " + name)
+        for name in (*REQUIRED, "bundle.json"):
+            if f"{ROOT_NAME}/{name}" not in names:
+                raise ValueError("Bundle file missing: " + name)
+        env = package.read(f"{ROOT_NAME}/.env.example").decode("utf-8-sig")
+        preset = hardware_preset(env)
+        if f"{ROOT_NAME}/{preset}" not in names:
+            raise ValueError("Hardware preset missing from bundle: " + preset)
+        manifest = json.loads(package.read(f"{ROOT_NAME}/bundle.json"))
+        actual = {(entry["frequency_hz"], entry["display_mode"]) for entry in manifest["variants"]}
+        if manifest.get("schema") != 1 or actual != set(expected):
+            raise ValueError("Bundle variants do not match the requested CI selection.")
+        for hz, mode in expected:
+            prefix = f"{ROOT_NAME}/{variant_path(hz, mode)}"
+            for name in ("driver.vrdrivermanifest", "bin/win64/driver_xr_tracking.dll", "bin/win64/openvr_api.dll",
+                         "resources/settings/default.vrsettings", "LICENSE", "THIRD_PARTY_NOTICES.md"):
+                if f"{prefix}/{name}" not in names:
+                    raise ValueError("Driver file missing: " + prefix + "/" + name)
+            settings = json.loads(package.read(prefix + "/resources/settings/default.vrsettings"))["xr_tracking"]
+            if settings.get("displayFrequency") != hz:
+                raise ValueError("Unexpected driver frequency: " + prefix)
+            for key in ("runtimePoseTransport", "runtimeHandTransport", "runtimeControllerStateTransport"):
+                if settings.get(key) != "tcp":
+                    raise ValueError("Windows driver must use TCP: " + prefix)
+            if settings.get("isDisplayOnDesktop") != (mode == "extended_sbs"):
+                raise ValueError("Unexpected display mode: " + prefix)
+    return manifest
+
+
+def build(source, drivers, output, frequencies, modes, release_tag="latest"):
+    variants = selections(frequencies, modes)
+    if not re.fullmatch(r"[A-Za-z0-9_.-]+", release_tag):
+        raise ValueError("Invalid release tag.")
+    with tempfile.TemporaryDirectory() as temporary:
+        bundle = Path(temporary) / ROOT_NAME
+        bundle.mkdir()
+        for path in sorted(source.rglob("*")):
+            relative = path.relative_to(source)
+            if not path.is_file() or any(part.startswith(".") or part in ("tests", "__pycache__") for part in relative.parts):
+                continue
+            if relative.name == "package_windows.py":
+                continue
+            target = bundle / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(path, target)
+        shutil.copy2(source / ".env.example", bundle / ".env.example")
+        env = (bundle / ".env.example").read_text(encoding="utf-8")
+        env = re.sub(r"(?m)^XR_RELEASE_TAG=.*$", "XR_RELEASE_TAG=" + release_tag, env)
+        (bundle / ".env.example").write_text(env, encoding="utf-8", newline="\n")
+        # Make the first install select a variant included in this CI run.
+        preset = bundle / hardware_preset(env)
+        content = preset.read_text(encoding="utf-8")
+        values = dict(re.findall(r"(?m)^(XR_[A-Z_]+)=(.*)$", content))
+        hz = values.get("XR_DISPLAY_FREQUENCY_HZ", "")
+        preferred = (int(hz), values.get("XR_DISPLAY_MODE", "")) if hz.isdigit() else None
+        if preferred not in variants:
+            preferred = variants[0]
+        for key, value in (("XR_DISPLAY_FREQUENCY_HZ", str(preferred[0])), ("XR_DISPLAY_MODE", preferred[1])):
+            content = re.sub(r"(?m)^" + key + "=.*$", key + "=" + value, content)
+        preset.write_text(content, encoding="utf-8", newline="\n")
+        entries = []
+        for hz, mode in variants:
+            relative = variant_path(hz, mode)
+            package = drivers / f"{hz}Hz-{mode}" / "xr_tracking"
+            if not package.is_dir():
+                raise FileNotFoundError("Selected Windows driver was not built: " + str(package))
+            target = bundle / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copytree(package, target)
+            entries.append({"frequency_hz": hz, "display_mode": mode, "path": relative})
+        (bundle / "bundle.json").write_text(json.dumps({
+            "schema": 1, "release_tag": release_tag, "variants": entries,
+        }, indent=2) + "\n", encoding="utf-8", newline="\n")
+        output.parent.mkdir(parents=True, exist_ok=True)
+        with ZipFile(output, "w", ZIP_DEFLATED) as package:
+            for path in sorted(bundle.rglob("*")):
+                if path.is_file():
+                    package.write(path, path.relative_to(bundle.parent).as_posix())
+    verify(output, frequencies, modes)
+    with output.open("rb") as stream:
+        digest = hashlib.file_digest(stream, "sha256").hexdigest()
+    output.with_name(output.name + ".sha256").write_text(digest + "  " + output.name + "\n", encoding="ascii", newline="\n")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest="command", required=True)
+    create = commands.add_parser("build")
+    create.add_argument("--source", type=Path, default=Path(__file__).resolve().parent)
+    create.add_argument("--drivers-root", type=Path, required=True)
+    create.add_argument("--output", type=Path, required=True)
+    create.add_argument("--release-tag", default="latest")
+    check = commands.add_parser("verify")
+    check.add_argument("archive", type=Path)
+    for command in (create, check):
+        command.add_argument("--frequencies", required=True)
+        command.add_argument("--modes", required=True)
+    args = parser.parse_args()
+    if args.command == "build":
+        build(args.source, args.drivers_root, args.output, args.frequencies, args.modes, args.release_tag)
+    else:
+        verify(args.archive, args.frequencies, args.modes)
+    print("OK Windows bundle: " + str(args.output if args.command == "build" else args.archive))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/win/tests/test_bundle.py b/win/tests/test_bundle.py
new file mode 100644
index 0000000..94d36e2
--- /dev/null
+++ b/win/tests/test_bundle.py
@@ -0,0 +1,163 @@
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+import tempfile
+import unittest
+from zipfile import ZipFile
+
+WIN = Path(__file__).resolve().parents[1]
+
+
+def module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
+
+
+packager = module("windows_packager", WIN / "package_windows.py")
+linux = module("windows_linux_helper", WIN / "linux/xr_gate_wsl.py")
+
+
+class HardwareTest(unittest.TestCase):
+    def runtime(self, root, settings):
+        runtime = linux.Runtime.__new__(linux.Runtime)
+        runtime.cfg = {"settings": settings}
+        runtime.settings = settings
+        runtime.base = root
+        runtime.current = root / "current"
+        runtime.config = root / "config"
+        runtime.current.mkdir()
+        runtime.config.mkdir()
+        def write(path, text):
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(text)
+        runtime.write = write
+        return runtime
+
+    def test_generic_usb_selection_excludes_unrelated_camera_and_hid(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            runtime = self.runtime(root, {"XR_USB_IDS": "1234:abcd"})
+            sysroot, devroot = root / "sys", root / "dev"
+            for name, vendor, number in (("selected", "1234", "11"), ("other", "3318", "12")):
+                usb = sysroot / "devices" / name
+                usb.mkdir(parents=True)
+                (usb / "idVendor").write_text(vendor)
+                (usb / "idProduct").write_text("abcd")
+                for category, prefix in (("video4linux", "video"), ("hidraw", "hidraw"), ("tty", "ttyACM")):
+                    actual = usb / category / (prefix + number)
+                    actual.mkdir(parents=True)
+                    link = sysroot / "class" / category / actual.name
+                    link.parent.mkdir(parents=True, exist_ok=True)
+                    link.symlink_to(actual)
+            nodes, cameras, hids = runtime.device_nodes(sysroot, devroot)
+            self.assertEqual(cameras, [devroot / "video11"])
+            self.assertEqual(hids, [devroot / "hidraw11"])
+            self.assertIn(devroot / "ttyACM11", nodes)
+            self.assertFalse(any("12" in str(node) for node in nodes))
+            runtime.settings = {"XR_USB_IDS": "", "XR_CAMERA_DEVICE": str(devroot / "video12")}
+            self.assertEqual(runtime.device_nodes(sysroot, devroot)[1], [devroot / "video12"])
+
+    def test_profile_and_controller_provider_come_from_settings(self):
+        with tempfile.TemporaryDirectory() as folder:
+            runtime = self.runtime(Path(folder), {"XR_PROFILE": "custom_camera", "XR_CONTROLLER_PROVIDERS": "custom_input"})
+            profile = runtime.current / "bin/python/xr_client/configs/custom_camera.json"
+            profile.parent.mkdir(parents=True)
+            profile.write_text(json.dumps({"post_gate_services": [{"name": "override_controller", "env": {}}]}))
+            generated = runtime.generate_profile()
+            data = json.loads(generated.read_text())
+            self.assertEqual(generated.name, "profile.json")
+            self.assertEqual(data["post_gate_services"][0]["env"]["PROVIDERS"], "custom_input")
+            custom = runtime.config / "xr_client.json"
+            custom.write_text('{"custom":true}')
+            self.assertEqual(runtime.generate_profile(), custom)
+
+    def test_custom_display_geometry_and_tcp_are_applied_to_both_settings_files(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            driver, steam = root / "driver.json", root / "steam.json"
+            driver.write_text('{"keep":true,"xr_tracking":{"modelNumber":"XREAL Air 2 Ultra"}}')
+            steam.write_text('{"steamvr":{"debugMode":true,"DebugMode":true}}')
+            request = {"window_x": -2520, "window_y": 120, "frequency_hz": 72,
+                       "display_mode": "extended_sbs", "driver_settings": str(driver), "steamvr_settings": str(steam),
+                       "settings": {"XR_WINDOW_WIDTH": "2520", "XR_WINDOW_HEIGHT": "1440", "XR_RENDER_WIDTH": "1260",
+                                    "XR_RENDER_HEIGHT": "1440", "XR_TCP_PORT": "45910", "XR_TCP_HOST": "127.0.0.1"}}
+            linux.configure_windows_display(request)
+            for file in (driver, steam):
+                data = json.loads(file.read_text())
+                self.assertEqual(data["xr_tracking"]["windowWidth"], 2520)
+                self.assertEqual(data["xr_tracking"]["renderWidth"], 1260)
+                self.assertEqual(data["xr_tracking"]["displayFrequency"], 72)
+                if file == driver:
+                    self.assertEqual(data["xr_tracking"]["modelNumber"], "XREAL Air 2 Ultra")
+                else:
+                    self.assertNotIn("modelNumber", data["xr_tracking"])
+                self.assertEqual(data["xr_tracking"]["runtimeTcpPort"], 45910)
+                self.assertFalse(data["steamvr"]["directMode"])
+            self.assertTrue(json.loads(driver.read_text())["keep"])
+            before = driver.read_bytes(), steam.read_bytes()
+            request["settings"]["XR_WINDOW_WIDTH"] = "0"
+            with self.assertRaises(ValueError):
+                linux.configure_windows_display(request)
+            self.assertEqual(before, (driver.read_bytes(), steam.read_bytes()))
+
+
+class PackageTest(unittest.TestCase):
+    def drivers(self, root, frequencies="60 90", modes="direct extended_sbs"):
+        for hz, mode in packager.selections(frequencies, modes):
+            package = root / f"{hz}Hz-{mode}" / "xr_tracking"
+            for name in ("driver.vrdrivermanifest", "bin/win64/driver_xr_tracking.dll", "bin/win64/openvr_api.dll",
+                         "LICENSE", "THIRD_PARTY_NOTICES.md"):
+                path = package / name
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text("fixture")
+            settings = package / "resources/settings/default.vrsettings"
+            settings.parent.mkdir(parents=True)
+            settings.write_text(json.dumps({"xr_tracking": {"modelNumber": "XREAL Air 2 Ultra", "displayFrequency": hz,
+                "isDisplayOnDesktop": mode == "extended_sbs", "runtimePoseTransport": "tcp", "runtimeHandTransport": "tcp",
+                "runtimeControllerStateTransport": "tcp"}}))
+
+    def test_one_archive_contains_all_variants_and_complete_installer_without_user_env(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            source = root / "win"
+            shutil.copytree(WIN, source, ignore=shutil.ignore_patterns("__pycache__", "tests"))
+            (source / ".env").write_text("PRIVATE=value")
+            self.drivers(root / "drivers")
+            archive = root / "xr-gate-windows.zip"
+            packager.build(source, root / "drivers", archive, "60 90", "direct extended_sbs", "v9.9.9")
+            manifest = packager.verify(archive, "60 90", "direct extended_sbs")
+            self.assertEqual(len(manifest["variants"]), 4)
+            with ZipFile(archive) as package:
+                self.assertNotIn("xr-gate-windows/.env", package.namelist())
+                self.assertIn(b"XR_RELEASE_TAG=v9.9.9", package.read("xr-gate-windows/.env.example"))
+                for hz, mode in packager.selections("60 90", "direct extended_sbs"):
+                    relative = packager.variant_path(hz, mode)
+                    original = root / "drivers" / f"{hz}Hz-{mode}" / "xr_tracking"
+                    for source_file in original.rglob("*"):
+                        if source_file.is_file():
+                            entry = f"{packager.ROOT_NAME}/{relative}/{source_file.relative_to(original).as_posix()}"
+                            self.assertEqual(package.read(entry), source_file.read_bytes())
+            self.assertTrue(archive.with_suffix(".zip.sha256").is_file())
+
+    def test_single_selected_variant_sets_installable_defaults_and_missing_driver_fails(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root = Path(folder)
+            self.drivers(root / "drivers", "90", "direct")
+            archive = root / "xr-gate-windows.zip"
+            packager.build(WIN, root / "drivers", archive, "90", "direct")
+            with ZipFile(archive) as package:
+                env = package.read("xr-gate-windows/.env.example").decode()
+                preset = package.read("xr-gate-windows/" + packager.hardware_preset(env)).decode()
+                self.assertIn("XR_DISPLAY_FREQUENCY_HZ=90", preset)
+                self.assertIn("XR_DISPLAY_MODE=direct", preset)
+            with self.assertRaises(ValueError):
+                packager.verify(archive, "60 90", "direct")
+            with self.assertRaises(FileNotFoundError):
+                packager.build(WIN, root / "drivers", archive, "60 90", "direct")
+
+
+if __name__ == "__main__":
+    unittest.main()
